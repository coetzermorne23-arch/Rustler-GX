{
  "version": 8,
  "name": "Rustler GX Dark",
  "sources": {
    "openmaptiles": {
      "type": "vector"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101214"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#172b38"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#182019",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#1e3124",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#30363b",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "minor-road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "track",
        "path"
      ],
      "paint": {
        "line-color": "#586064",
        "line-width": 1.2
      }
    },
    {
      "id": "street-road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "street",
        "secondary",
        "tertiary"
      ],
      "paint": {
        "line-color": "#949b9e",
        "line-width": 2.0
      }
    },
    {
      "id": "primary-road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "primary",
        "trunk"
      ],
      "paint": {
        "line-color": "#d4d7d8",
        "line-width": 3.2
      }
    },
    {
      "id": "motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "motorway"
      ],
      "paint": {
        "line-color": "#e6e9ea",
        "line-width": 4.2
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-size": 11
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#101214",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": 14
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#101214",
        "text-halo-width": 2
      }
    }
  ]
}