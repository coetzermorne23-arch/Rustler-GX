{
  "version": 8,
  "name": "Rustler GX Dark V2",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["https://rustler.invalid/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {"id":"background","type":"background","paint":{"background-color":"#0b1013"}},
    {"id":"landcover","type":"fill","source":"openmaptiles","source-layer":"landcover","paint":{"fill-color":"#18211d","fill-opacity":0.65}},
    {"id":"landuse","type":"fill","source":"openmaptiles","source-layer":"landuse","paint":{"fill-color":"#17201d","fill-opacity":0.5}},
    {"id":"water","type":"fill","source":"openmaptiles","source-layer":"water","paint":{"fill-color":"#102c3b"}},
    {"id":"waterway","type":"line","source":"openmaptiles","source-layer":"waterway","paint":{"line-color":"#1b4c63","line-width":1.2}},
    {"id":"building","type":"fill","source":"openmaptiles","source-layer":"building","minzoom":13,"paint":{"fill-color":"#252c30","fill-outline-color":"#303a3f"}},
    {"id":"minor-roads","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["in","class","minor","service","path","track"],"paint":{"line-color":"#465057","line-width":1.8}},
    {"id":"major-roads","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["in","class","motorway","trunk","primary","secondary","tertiary"],"paint":{"line-color":"#65727a","line-width":4}},
    {"id":"road-labels","type":"symbol","source":"openmaptiles","source-layer":"transportation_name","minzoom":8,"layout":{"symbol-placement":"line","text-field":["coalesce",["get","name"],["get","ref"]],"text-size":13,"text-padding":4},"paint":{"text-color":"#e6edf0","text-halo-color":"#0b1013","text-halo-width":2}},
    {"id":"place-labels","type":"symbol","source":"openmaptiles","source-layer":"place","minzoom":3,"layout":{"text-field":["get","name"],"text-size":14,"text-padding":5},"paint":{"text-color":"#f1f5f6","text-halo-color":"#0b1013","text-halo-width":2}},
    {"id":"poi-labels","type":"symbol","source":"openmaptiles","source-layer":"poi","minzoom":13,"layout":{"text-field":["get","name"],"text-size":11,"text-padding":3},"paint":{"text-color":"#c8d3d8","text-halo-color":"#0b1013","text-halo-width":1.5}},
    {"id":"water-labels","type":"symbol","source":"openmaptiles","source-layer":"water_name","minzoom":8,"layout":{"text-field":["get","name"],"text-size":11},"paint":{"text-color":"#78a9c1","text-halo-color":"#0b1013","text-halo-width":1.5}},
    {"id":"house-numbers","type":"symbol","source":"openmaptiles","source-layer":"housenumber","minzoom":14,"layout":{"text-field":["get","housenumber"],"text-size":9},"paint":{"text-color":"#9aa7ad","text-halo-color":"#0b1013","text-halo-width":1}}
  ]
}
