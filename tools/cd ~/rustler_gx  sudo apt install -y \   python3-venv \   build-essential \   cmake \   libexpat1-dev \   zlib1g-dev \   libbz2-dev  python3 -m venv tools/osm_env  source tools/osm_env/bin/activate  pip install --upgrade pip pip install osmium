#!/usr/bin/env python3

import argparse
import math
import os
import sqlite3
import sys
import time

import osmium


# ============================================================
# CONFIG
# ============================================================

ROUTABLE_HIGHWAYS = {
    "motorway",
    "motorway_link",
    "trunk",
    "trunk_link",
    "primary",
    "primary_link",
    "secondary",
    "secondary_link",
    "tertiary",
    "tertiary_link",
    "unclassified",
    "residential",
    "living_street",
    "service",
    "road",
    "track",
}


DEFAULT_SPEEDS = {
    "motorway": 120,
    "motorway_link": 80,
    "trunk": 100,
    "trunk_link": 70,
    "primary": 80,
    "primary_link": 60,
    "secondary": 70,
    "secondary_link": 50,
    "tertiary": 60,
    "tertiary_link": 50,
    "unclassified": 50,
    "residential": 40,
    "living_street": 20,
    "service": 25,
    "road": 40,
    "track": 20,
}


SEARCHABLE_AMENITIES = {
    "fuel",
    "restaurant",
    "fast_food",
    "cafe",
    "hospital",
    "clinic",
    "pharmacy",
    "police",
    "fire_station",
    "bank",
    "atm",
    "parking",
    "toilets",
    "drinking_water",
    "school",
    "university",
    "college",
    "library",
    "post_office",
    "marketplace",
    "car_wash",
}


SEARCHABLE_TOURISM = {
    "camp_site",
    "caravan_site",
    "hotel",
    "motel",
    "guest_house",
    "hostel",
    "attraction",
    "viewpoint",
    "museum",
    "information",
}


SEARCHABLE_SHOPS = {
    "supermarket",
    "convenience",
    "mall",
    "department_store",
    "hardware",
    "car",
    "car_repair",
    "tyres",
    "electronics",
    "mobile_phone",
}


SEARCHABLE_PLACES = {
    "city",
    "town",
    "village",
    "suburb",
    "neighbourhood",
    "hamlet",
}


# ============================================================
# HELPERS
# ============================================================

def haversine_metres(lat1, lon1, lat2, lon2):
    radius = 6371000.0

    phi1 = math.radians(lat1)
    phi2 = math.radians(lat2)

    delta_phi = math.radians(lat2 - lat1)
    delta_lambda = math.radians(lon2 - lon1)

    a = (
        math.sin(delta_phi / 2.0) ** 2
        + math.cos(phi1)
        * math.cos(phi2)
        * math.sin(delta_lambda / 2.0) ** 2
    )

    c = 2.0 * math.atan2(
        math.sqrt(a),
        math.sqrt(1.0 - a),
    )

    return radius * c


def parse_speed(value, highway):
    if not value:
        return DEFAULT_SPEEDS.get(
            highway,
            50,
        )

    text = str(value).lower().strip()

    if ";" in text:
        text = text.split(";")[0].strip()

    if text in {
        "walk",
        "signals",
        "none",
        "national",
        "urban",
        "rural",
    }:
        return DEFAULT_SPEEDS.get(
            highway,
            50,
        )

    try:
        if "mph" in text:
            number = float(
                text.replace("mph", "").strip()
            )

            return max(
                5,
                min(
                    int(number * 1.609344),
                    140,
                ),
            )

        cleaned = (
            text
            .replace("km/h", "")
            .replace("kph", "")
            .strip()
        )

        speed = int(float(cleaned))

        return max(
            5,
            min(
                speed,
                140,
            ),
        )

    except ValueError:
        return DEFAULT_SPEEDS.get(
            highway,
            50,
        )


def parse_oneway(tags):
    value = tags.get(
        "oneway",
        "",
    ).lower()

    junction = tags.get(
        "junction",
        "",
    ).lower()

    highway = tags.get(
        "highway",
        "",
    ).lower()

    if value in {
        "yes",
        "true",
        "1",
    }:
        return 1

    if value == "-1":
        return -1

    if junction == "roundabout":
        return 1

    if highway in {
        "motorway",
        "motorway_link",
    }:
        return 1

    return 0


def build_address(tags):
    parts = []

    house_number = tags.get(
        "addr:housenumber"
    )

    street = tags.get(
        "addr:street"
    )

    suburb = (
        tags.get("addr:suburb")
        or tags.get("addr:place")
    )

    city = (
        tags.get("addr:city")
        or tags.get("addr:town")
        or tags.get("addr:village")
    )

    postcode = tags.get(
        "addr:postcode"
    )

    if house_number and street:
        parts.append(
            f"{house_number} {street}"
        )
    elif street:
        parts.append(street)
    elif house_number:
        parts.append(house_number)

    if suburb:
        parts.append(suburb)

    if city:
        parts.append(city)

    if postcode:
        parts.append(postcode)

    if not parts:
        return None

    return ", ".join(parts)


def get_place_category(tags):
    amenity = tags.get("amenity")

    if amenity in SEARCHABLE_AMENITIES:
        return amenity

    tourism = tags.get("tourism")

    if tourism in SEARCHABLE_TOURISM:
        return tourism

    shop = tags.get("shop")

    if shop in SEARCHABLE_SHOPS:
        return shop

    place = tags.get("place")

    if place in SEARCHABLE_PLACES:
        return place

    if tags.get("leisure") == "park":
        return "park"

    if tags.get("leisure") == "nature_reserve":
        return "nature_reserve"

    if tags.get("natural") == "peak":
        return "peak"

    return None


# ============================================================
# ROAD DATABASE
# ============================================================

def create_road_database(path):
    if os.path.exists(path):
        os.remove(path)

    db = sqlite3.connect(path)

    db.execute(
        "PRAGMA journal_mode = WAL;"
    )

    db.execute(
        "PRAGMA synchronous = OFF;"
    )

    db.execute(
        "PRAGMA temp_store = MEMORY;"
    )

    db.execute(
        """
        CREATE TABLE road_nodes (
            id INTEGER PRIMARY KEY,
            latitude REAL NOT NULL,
            longitude REAL NOT NULL
        );
        """
    )

    db.execute(
        """
        CREATE TABLE road_edges (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            from_node INTEGER NOT NULL,
            to_node INTEGER NOT NULL,
            distance_metres REAL NOT NULL,
            speed_kmh REAL NOT NULL,
            road_name TEXT,
            one_way INTEGER NOT NULL DEFAULT 0
        );
        """
    )

    return db


# ============================================================
# SEARCH DATABASE
# ============================================================

def create_search_database(path):
    if os.path.exists(path):
        os.remove(path)

    db = sqlite3.connect(path)

    db.execute(
        "PRAGMA journal_mode = WAL;"
    )

    db.execute(
        "PRAGMA synchronous = OFF;"
    )

    db.execute(
        """
        CREATE TABLE places (
            id INTEGER PRIMARY KEY AUTOINCREMENT,

            osm_type TEXT,
            osm_id INTEGER,

            name TEXT NOT NULL,
            address TEXT,

            latitude REAL NOT NULL,
            longitude REAL NOT NULL,

            category TEXT,

            favourite INTEGER NOT NULL DEFAULT 0,
            is_home INTEGER NOT NULL DEFAULT 0,
            is_work INTEGER NOT NULL DEFAULT 0,

            visit_count INTEGER NOT NULL DEFAULT 0,
            last_visited TEXT
        );
        """
    )

    db.execute(
        """
        CREATE INDEX idx_places_name
        ON places(name);
        """
    )

    db.execute(
        """
        CREATE INDEX idx_places_address
        ON places(address);
        """
    )

    db.execute(
        """
        CREATE INDEX idx_places_category
        ON places(category);
        """
    )

    return db


# ============================================================
# PASS 1
#
# Find all nodes that belong to routable roads.
# ============================================================

class RoadNodeCollector(
    osmium.SimpleHandler
):
    def __init__(self):
        super().__init__()

        self.node_ids = set()

        self.way_count = 0

    def way(self, way):
        highway = way.tags.get(
            "highway"
        )

        if highway not in ROUTABLE_HIGHWAYS:
            return

        if way.tags.get("area") == "yes":
            return

        self.way_count += 1

        for node in way.nodes:
            self.node_ids.add(
                node.ref
            )

        if self.way_count % 100000 == 0:
            print(
                f"  routable ways: "
                f"{self.way_count:,}"
            )


# ============================================================
# PASS 2
#
# Save coordinates for required road nodes.
# Also collect searchable node POIs.
# ============================================================

class NodeWriter(
    osmium.SimpleHandler
):
    def __init__(
        self,
        road_db,
        search_db,
        required_nodes,
    ):
        super().__init__()

        self.road_db = road_db
        self.search_db = search_db

        self.required_nodes = (
            required_nodes
        )

        self.coordinates = {}

        self.saved_nodes = 0
        self.saved_places = 0

        self.road_batch = []
        self.place_batch = []

    def node(self, node):
        if not node.location.valid():
            return

        lat = node.location.lat
        lon = node.location.lon

        if node.id in self.required_nodes:
            self.coordinates[node.id] = (
                lat,
                lon,
            )

            self.road_batch.append(
                (
                    node.id,
                    lat,
                    lon,
                )
            )

            self.saved_nodes += 1

            if len(self.road_batch) >= 50000:
                self.flush_roads()

        tags = node.tags

        name = tags.get("name")

        category = get_place_category(
            tags
        )

        address = build_address(
            tags
        )

        if name and (
            category is not None
            or address is not None
        ):
            self.place_batch.append(
                (
                    "node",
                    node.id,
                    name,
                    address,
                    lat,
                    lon,
                    category,
                )
            )

            self.saved_places += 1

            if len(self.place_batch) >= 10000:
                self.flush_places()

    def flush_roads(self):
        if not self.road_batch:
            return

        self.road_db.executemany(
            """
            INSERT OR REPLACE INTO road_nodes (
                id,
                latitude,
                longitude
            )
            VALUES (?, ?, ?);
            """,
            self.road_batch,
        )

        self.road_db.commit()

        self.road_batch.clear()

    def flush_places(self):
        if not self.place_batch:
            return

        self.search_db.executemany(
            """
            INSERT INTO places (
                osm_type,
                osm_id,
                name,
                address,
                latitude,
                longitude,
                category
            )
            VALUES (?, ?, ?, ?, ?, ?, ?);
            """,
            self.place_batch,
        )

        self.search_db.commit()

        self.place_batch.clear()


# ============================================================
# PASS 3
#
# Convert routable OSM ways into directed graph edges.
# ============================================================

class EdgeWriter(
    osmium.SimpleHandler
):
    def __init__(
        self,
        db,
        coordinates,
    ):
        super().__init__()

        self.db = db

        self.coordinates = (
            coordinates
        )

        self.edge_batch = []

        self.way_count = 0
        self.edge_count = 0

    def way(self, way):
        highway = way.tags.get(
            "highway"
        )

        if highway not in ROUTABLE_HIGHWAYS:
            return

        if way.tags.get("area") == "yes":
            return

        nodes = [
            node.ref
            for node in way.nodes
        ]

        if len(nodes) < 2:
            return

        oneway = parse_oneway(
            way.tags
        )

        speed = parse_speed(
            way.tags.get("maxspeed"),
            highway,
        )

        road_name = (
            way.tags.get("name")
            or way.tags.get("ref")
        )

        self.way_count += 1

        for index in range(
            len(nodes) - 1
        ):
            a = nodes[index]
            b = nodes[index + 1]

            coord_a = self.coordinates.get(a)
            coord_b = self.coordinates.get(b)

            if (
                coord_a is None
                or coord_b is None
            ):
                continue

            distance = haversine_metres(
                coord_a[0],
                coord_a[1],
                coord_b[0],
                coord_b[1],
            )

            if distance <= 0:
                continue

            if oneway == 1:
                self.add_edge(
                    a,
                    b,
                    distance,
                    speed,
                    road_name,
                    1,
                )

            elif oneway == -1:
                self.add_edge(
                    b,
                    a,
                    distance,
                    speed,
                    road_name,
                    1,
                )

            else:
                self.add_edge(
                    a,
                    b,
                    distance,
                    speed,
                    road_name,
                    0,
                )

                self.add_edge(
                    b,
                    a,
                    distance,
                    speed,
                    road_name,
                    0,
                )

        if len(self.edge_batch) >= 50000:
            self.flush()

        if self.way_count % 100000 == 0:
            print(
                f"  processed ways: "
                f"{self.way_count:,} | "
                f"edges: "
                f"{self.edge_count:,}"
            )

    def add_edge(
        self,
        from_node,
        to_node,
        distance,
        speed,
        road_name,
        one_way,
    ):
        self.edge_batch.append(
            (
                from_node,
                to_node,
                distance,
                speed,
                road_name,
                one_way,
            )
        )

        self.edge_count += 1

    def flush(self):
        if not self.edge_batch:
            return

        self.db.executemany(
            """
            INSERT INTO road_edges (
                from_node,
                to_node,
                distance_metres,
                speed_kmh,
                road_name,
                one_way
            )
            VALUES (?, ?, ?, ?, ?, ?);
            """,
            self.edge_batch,
        )

        self.db.commit()

        self.edge_batch.clear()


# ============================================================
# INDEXES
# ============================================================

def finalise_road_database(db):
    print(
        "Creating road indexes..."
    )

    db.execute(
        """
        CREATE INDEX idx_edges_from_node
        ON road_edges(from_node);
        """
    )

    db.execute(
        """
        CREATE INDEX idx_edges_to_node
        ON road_edges(to_node);
        """
    )

    db.execute(
        """
        CREATE INDEX idx_nodes_latitude
        ON road_nodes(latitude);
        """
    )

    db.execute(
        """
        CREATE INDEX idx_nodes_longitude
        ON road_nodes(longitude);
        """
    )

    db.execute(
        "ANALYZE;"
    )

    db.commit()


def finalise_search_database(db):
    print(
        "Creating search indexes..."
    )

    try:
        db.execute(
            """
            CREATE VIRTUAL TABLE places_fts
            USING fts5(
                name,
                address,
                category,
                content='places',
                content_rowid='id'
            );
            """
        )

        db.execute(
            """
            INSERT INTO places_fts(
                rowid,
                name,
                address,
                category
            )
            SELECT
                id,
                name,
                address,
                category
            FROM places;
            """
        )

        print(
            "FTS5 search index created."
        )

    except sqlite3.OperationalError as error:
        print(
            "FTS5 unavailable:",
            error,
        )

        print(
            "Normal indexed search "
            "will still work."
        )

    db.execute(
        "ANALYZE;"
    )

    db.commit()


# ============================================================
# MAIN
# ============================================================

def main():
    parser = argparse.ArgumentParser(
        description=(
            "Build Rustler GX offline "
            "navigation databases from OSM PBF."
        )
    )

    parser.add_argument(
        "pbf",
        help="Input .osm.pbf file",
    )

    parser.add_argument(
        "--output",
        default="map_output",
        help="Output directory",
    )

    args = parser.parse_args()

    pbf_path = os.path.abspath(
        args.pbf
    )

    output_directory = os.path.abspath(
        args.output
    )

    if not os.path.isfile(
        pbf_path
    ):
        print(
            "PBF file not found:",
            pbf_path,
        )

        sys.exit(1)

    os.makedirs(
        output_directory,
        exist_ok=True,
    )

    roads_path = os.path.join(
        output_directory,
        "rustler_roads.db",
    )

    search_path = os.path.join(
        output_directory,
        "rustler_navigation.db",
    )

    print()
    print(
        "=========================================="
    )
    print(
        " RUSTLER GX SOUTH AFRICA NAVIGATION BUILD"
    )
    print(
        "=========================================="
    )
    print()
    print(
        "Input:",
        pbf_path,
    )
    print(
        "Road DB:",
        roads_path,
    )
    print(
        "Search DB:",
        search_path,
    )
    print()

    start_time = time.time()

    road_db = create_road_database(
        roads_path
    )

    search_db = create_search_database(
        search_path
    )

    # --------------------------------------------------------
    # PASS 1
    # --------------------------------------------------------

    print(
        "[PASS 1/3] Finding routable roads..."
    )

    collector = RoadNodeCollector()

    collector.apply_file(
        pbf_path,
        locations=False,
    )

    print()
    print(
        "Routable ways:",
        f"{collector.way_count:,}",
    )

    print(
        "Required road nodes:",
        f"{len(collector.node_ids):,}",
    )

    print()

    # --------------------------------------------------------
    # PASS 2
    # --------------------------------------------------------

    print(
        "[PASS 2/3] Loading road coordinates "
        "and searchable places..."
    )

    node_writer = NodeWriter(
        road_db,
        search_db,
        collector.node_ids,
    )

    node_writer.apply_file(
        pbf_path,
        locations=True,
    )

    node_writer.flush_roads()
    node_writer.flush_places()

    print()
    print(
        "Road nodes written:",
        f"{node_writer.saved_nodes:,}",
    )

    print(
        "Search places written:",
        f"{node_writer.saved_places:,}",
    )

    print()

    # --------------------------------------------------------
    # PASS 3
    # --------------------------------------------------------

    print(
        "[PASS 3/3] Building directed road graph..."
    )

    edge_writer = EdgeWriter(
        road_db,
        node_writer.coordinates,
    )

    edge_writer.apply_file(
        pbf_path,
        locations=False,
    )

    edge_writer.flush()

    print()
    print(
        "Road edges written:",
        f"{edge_writer.edge_count:,}",
    )

    print()

    # --------------------------------------------------------
    # FINALISE
    # --------------------------------------------------------

    finalise_road_database(
        road_db
    )

    finalise_search_database(
        search_db
    )

    road_node_count = road_db.execute(
        """
        SELECT COUNT(*)
        FROM road_nodes;
        """
    ).fetchone()[0]

    road_edge_count = road_db.execute(
        """
        SELECT COUNT(*)
        FROM road_edges;
        """
    ).fetchone()[0]

    place_count = search_db.execute(
        """
        SELECT COUNT(*)
        FROM places;
        """
    ).fetchone()[0]

    road_db.close()
    search_db.close()

    elapsed = time.time() - start_time

    print()
    print(
        "=========================================="
    )
    print(
        " BUILD COMPLETE"
    )
    print(
        "=========================================="
    )
    print()

    print(
        "Road nodes:",
        f"{road_node_count:,}",
    )

    print(
        "Road edges:",
        f"{road_edge_count:,}",
    )

    print(
        "Search places:",
        f"{place_count:,}",
    )

    print()

    print(
        "Road DB:"
    )
    print(
        roads_path
    )

    print()

    print(
        "Search DB:"
    )
    print(
        search_path
    )

    print()

    print(
        "Build time:",
        f"{elapsed / 60:.1f} minutes",
    )

    print()


if __name__ == "__main__":
    main()